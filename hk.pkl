amends "package://github.com/jdx/hk/releases/download/v1.48.0/hk@1.48.0#/Config.pkl"

// Git hooks for kmux. Replaces lefthook.yml.
//
// Steps shell out to the mise tasks (`mise run fmt` / `clippy` / `test` / ...),
// so the cargo flags live in exactly ONE place (mise.toml) and local hooks, the
// `mise run` CLI, and CI all run identical commands.
//
// On pre-commit, `fix = true` + `stash = "git"` makes hk stash unstaged work,
// run the fixers, re-stage the touched *.rs, then restore the stash. That
// removes lefthook's manual `git diff --exit-code || "stage the changes and
// re-commit"` dance: auto-fixes land in the commit with no second commit.
//
// `cargo fmt`/`cargo clippy` already span the whole workspace, so we don't pass
// {{files}}; the glob only gates WHETHER a step runs (any staged *.rs) and which
// files get re-staged after a fix.

hooks {
    // Conventional-commit enforcement (issue #130), via convco (pinned in
    // mise.toml). commit-msg is the immediate gate as each message is written;
    // pre-push is the last local net for commits that bypassed it (--no-verify,
    // amend, rebase). CI re-checks the whole PR range authoritatively.
    ["commit-msg"] {
        steps = new Mapping<String, Step> {
            ["convco"] {
                // hk passes the message file as {{commit_msg_file}}; the task
                // skips merge messages and strips git's comment lines.
                check = "mise run commit-msg-check {{commit_msg_file}}"
            }
        }
    }
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = new Mapping<String, Step> {
            ["cargo-fmt"] {
                glob = List("*.rs")
                check = "mise run fmt-check"
                fix = "mise run fmt"
                stage = List("*.rs")
            }
            ["cargo-clippy"] {
                glob = List("*.rs")
                check = "mise run clippy"
                fix = "mise run clippy-fix"
                stage = List("*.rs")
                depends = List("cargo-fmt") // mirror lefthook's piped fmt -> clippy order
            }
        }
    }
    ["pre-push"] {
        steps = new Mapping<String, Step> {
            // No glob: lint the pushed commits regardless of which files changed
            // (default range is this branch's commits since the trunk).
            ["convco"] {
                check = "mise run commit-check"
            }
            ["cargo-fmt"] {
                glob = List("*.rs")
                check = "mise run fmt-check"
            }
            ["cargo-clippy"] {
                glob = List("*.rs")
                check = "mise run clippy"
                depends = List("cargo-fmt")
            }
            ["cargo-test"] {
                glob = List("*.rs")
                check = "mise run test"
                exclusive = true // run after the linters, not concurrently
            }
        }
    }
    // `hk check` / `hk check --all` parity path (read-only fmt + clippy).
    ["check"] {
        steps = new Mapping<String, Step> {
            ["cargo-fmt"] {
                glob = List("*.rs")
                check = "mise run fmt-check"
            }
            ["cargo-clippy"] {
                glob = List("*.rs")
                check = "mise run clippy"
                depends = List("cargo-fmt")
            }
        }
    }
}
