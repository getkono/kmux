tmp/

# === Rust ===
# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/


# Added by cargo

/target

# === Zig ===
# Build caches produced by `zig build` outside of $OUT_DIR (e.g. when the
# wrapper is invoked manually from crates/kmux-ghostty-sys/zig/ for spikes).
.zig-cache/
zig-out/

# === Release ===
# `mise run package` stages tarballs here; the release workflow uploads them.
/dist/
# Release notes scratch file produced by `git cliff` in the release workflow.
/RELEASE_NOTES.md
# Backup left by the in-place version bump in `mise run release`.
/Cargo.toml.bak

# === kmux-ffi ===
# Generated uniffi Swift bindings (regenerated from the built cdylib; see
# crates/kmux-ffi/src/bin/uniffi-bindgen.rs).
/crates/kmux-ffi/bindings/

# === kmux-swift (native macOS app) ===
# SwiftPM build products + the generated uniffi bindings (produced by
# `mise run gen-ffi-bindings`; the runtime ABI assert + uniffi checksum guard drift).
/kmux-swift/.build/
/kmux-swift/.swiftpm/
/kmux-swift/Sources/kmux_ffiFFI/kmux_ffiFFI.h
/kmux-swift/Sources/KmuxBindings/kmux_ffi.swift

# Claude Code agent worktrees (transient harness state)
.claude/worktrees/
