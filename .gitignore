# === Rust ===
# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/


# Added by cargo

/target

# === Zig ===
# Build caches produced by `zig build` outside of $OUT_DIR (e.g. when the
# wrapper is invoked manually from crates/kmux-ghostty-sys/zig/ for spikes).
.zig-cache/
zig-out/
