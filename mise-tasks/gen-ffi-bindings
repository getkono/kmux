#!/usr/bin/env bash
#MISE description="Generate the uniffi Swift bindings from the built kmux-ffi cdylib (macOS-only)."
#USAGE arg "<profile>" help="Which built cdylib to introspect: debug|release" default="debug"
#
# The SwiftUI macOS client lives in kmux-swift/ (a SwiftPM package, outside the
# cargo workspace) and links the kmux-ffi staticlib. This task is macOS-only
# (gated like install/package); on Linux the GTK GUI (kmux-gtk) is the client.
set -euo pipefail
# Copy only when the bytes differ. uniffi emits identical Swift/header output as
# long as the FFI surface is unchanged, so preserving the destination's mtime in
# that case keeps SwiftPM (which keys recompilation on mtime) from needlessly
# rebuilding KmuxBindings/KmuxApp on every dev iteration. Returns 0 if it copied.
copy_if_changed() {
    local src="$1" dst="$2"
    if [[ -f "$dst" ]] && cmp -s "$src" "$dst"; then return 1; fi
    cp "$src" "$dst"
}
# The profile (debug|release) selects which built cdylib to introspect;
# `mise run install` passes "release" so the bindings match the release staticlib
# it links. The generated Swift is identical across profiles (it is derived from
# the crate metadata), so the default debug profile is fine for dev builds.
profile="${1:-debug}"
[[ "$(uname -s)" == "Darwin" ]] || { echo "error: gen-ffi-bindings is macOS-only (the Swift app is macOS-only)" >&2; exit 1; }
case "$profile" in
    debug)   relflag="" ;;
    release) relflag="--release" ;;
    *) echo "error: profile must be 'debug' or 'release' (got '$profile')" >&2; exit 1 ;;
esac
# Extra cargo features for kmux-ffi on top of the defaults. `gpu` is now a
# default feature (issue #132), so the KmuxRenderer object is in the bindings
# without setting anything; this hook remains for adding *other* features. The
# same flag is passed to the bindgen run so cargo does not rebuild the cdylib
# with a different feature set (which would change the introspected library).
featflag=()
[[ -n "${KMUX_FFI_FEATURES:-}" ]] && featflag=(--features "$KMUX_FFI_FEATURES")
cargo build $relflag "${featflag[@]}" -p kmux-ffi
out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT
# `--no-format` skips uniffi's optional swiftformat pass: the bindings are
# machine-generated (and gitignored), so formatting them is pointless, and
# without it uniffi prints a benign "Unable to auto-format" warning whenever
# swiftformat isn't installed (see issue #104).
cargo run "${featflag[@]}" -p kmux-ffi --bin uniffi-bindgen -- \
    generate --no-format --library "target/${profile}/libkmux_ffi.dylib" --language swift --out-dir "$out"
mkdir -p kmux-swift/Sources/kmux_ffiFFI kmux-swift/Sources/KmuxBindings
changed=0
copy_if_changed "$out/kmux_ffiFFI.h"  kmux-swift/Sources/kmux_ffiFFI/kmux_ffiFFI.h && changed=1
copy_if_changed "$out/kmux_ffi.swift" kmux-swift/Sources/KmuxBindings/kmux_ffi.swift && changed=1
if [[ "$changed" == 1 ]]; then
    echo "==> updated Swift bindings in kmux-swift/Sources/"
else
    echo "==> Swift bindings unchanged (FFI surface identical) — left as-is"
fi
