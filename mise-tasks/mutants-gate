#!/usr/bin/env bash
#MISE description="Judge a cargo-mutants sweep: reject implausible results, then hold survivors against the baseline."
#USAGE flag "--write" help="record the measured survivor counts as the new budget"
#
# Positional args are cargo-mutants output directories. Not declared with
# `#USAGE arg` because `var=true` plus `default=""` is not valid usage KDL and
# mise warns on every invocation; the default is computed below instead.
#
# `mise run mutants` writes one directory per crate-group; a scoped run writes
# mutants.out directly. Either is fine — the gate merges whatever it is given.
# cargo-mutants' `-o DIR` names the *parent* and creates `DIR/mutants.out/`
# inside it, so a group's results live one level deeper than the group name.
#
# The believability check runs FIRST and, when it fires, the budget comparison
# is skipped entirely. A fabricated 100% sails through any budget, and recording
# one with --write would enshrine it. See xtask/src/mutants.rs for the story
# behind that check.
set -euo pipefail

write=""
dirs=()
for arg in "$@"; do
    case "$arg" in
        --write) write="--write" ;;
        *) [[ -n "$arg" ]] && dirs+=("$arg") ;;
    esac
done

if [[ ${#dirs[@]} -eq 0 ]]; then
    for d in mutants.out/lib/mutants.out mutants.out/bin/mutants.out \
             mutants.out/bin-fast/mutants.out mutants.out; do
        [[ -f "$d/outcomes.json" ]] && dirs+=("$d")
    done
fi

if [[ ${#dirs[@]} -eq 0 ]]; then
    echo "mutants-gate: no outcomes.json found; run \`mise run mutants\` first" >&2
    exit 1
fi

exec cargo run -q -p xtask -- mutants-gate $write "${dirs[@]}"
