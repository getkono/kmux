#!/usr/bin/env bash
#MISE description="Mutation testing (cargo-mutants, pinned via mise; configs in .cargo/mutants*.toml)."
#
# Whole workspace by default; scope with `-p`, e.g. `mise run mutants -- -p kmux-app`.
# Any other flags are forwarded to cargo-mutants unchanged, e.g.
# `mise run mutants -- --shard 1/16` or `mise run mutants -- -D pr.diff`.
#
# WHY THIS DISPATCHES. cargo-mutants passes `additional_cargo_test_args` through
# verbatim and scopes the test phase to the mutated package. `--lib` hard-errors
# with "no library targets found" on a bin-only package, and cargo-mutants reads
# that non-zero exit as "mutant caught" — which is why the 2026-06-14 sweep
# reported a bogus 100% for kmuxd (712/0), kmux-gtk (608/0) and kmux (15/0)
# without testing a single mutant of them. There is no per-package config
# section in cargo-mutants 27.1.0, so the flags are selected here, per crate,
# via `--config`. See docs/testing.md §Mutation testing.
#
# cargo-mutants makes a full scratch copy (incl. a fresh target/) per job; the
# default /tmp is often a small tmpfs that overflows mid-sweep, so anchor the
# scratch trees on disk (override with $CARGO_MUTANTS_TMPDIR).
set -euo pipefail

export TMPDIR="${CARGO_MUTANTS_TMPDIR:-${XDG_CACHE_HOME:-$HOME/.cache}/cargo-mutants-tmp}"
mkdir -p "$TMPDIR"

# Crate groups, keyed by target shape. Keep in sync with .cargo/mutants*.toml
# and with the `every_workspace_member_is_classified` assertion in
# xtask/tests/dependency_direction.rs, which fails if a new crate is unlisted.
LIB_CRATES=(
    kmux-app kmux-client kmux-connect kmux-ffi kmux-ghostty kmux-protocol
    kmux-pty kmux-render kmux-sys kmux-vt-core kmux-worker-protocol
)
BIN_CRATES=(kmuxd kmux-gtk)
BIN_FAST_CRATES=(kmux kmux-vt-worker)
# kmux-ghostty-sys is a lib crate but is excluded wholesale by exclude_globs:
# raw C-ABI binding declarations carry no business logic worth mutating.

config_for() {
    local crate="$1" c
    for c in "${BIN_CRATES[@]}"; do
        [[ "$crate" == "$c" ]] && { echo ".cargo/mutants-bin.toml"; return; }
    done
    for c in "${BIN_FAST_CRATES[@]}"; do
        [[ "$crate" == "$c" ]] && { echo ".cargo/mutants-bin-fast.toml"; return; }
    done
    echo ".cargo/mutants.toml"
}

# Scoped run: `-p <crate>` picks that crate's config and runs a single pass.
# Multiple `-p` flags are only valid within one group; mixing shapes is what the
# unscoped path below is for.
scoped_crate=""
prev=""
for arg in "$@"; do
    case "$prev" in
        -p | --package) scoped_crate="$arg" ;;
    esac
    case "$arg" in
        -p=* | --package=*) scoped_crate="${arg#*=}" ;;
    esac
    prev="$arg"
done

if [[ -n "$scoped_crate" ]]; then
    exec cargo mutants --config "$(config_for "$scoped_crate")" "$@"
fi

# Unscoped: one pass per group, each into its own output directory so the
# per-package outcomes can be merged afterwards (mutants.out/ is gitignored).
# Every flag the caller gave goes to all three groups. Empty-array expansion is
# guarded below because `set -u` treats `"${a[@]}"` on an empty array as unbound
# on bash < 4.4 (macOS ships 3.2).
FORWARDED=("$@")

# `|| true` keeps a group with surviving mutants from aborting the remaining
# groups — cargo-mutants exits non-zero when any mutant is missed, and a sweep
# that stops at the first crate with debt would never reach the others. The
# authoritative pass/fail is the ratchet over the merged outcomes, not this
# exit code.
#
# `$@` here is the crate list; the caller's own flags travel separately in
# `FORWARDED`. An earlier version took only the crate list and dropped the
# caller's flags on the floor, which meant `--in-diff pr.diff` (the per-PR CI
# job) and `--shard n/8` (the weekly sweep) were silently ignored: the diff job
# swept the whole workspace, and all eight shards did the same full sweep eight
# times over. Nothing failed, so nothing said so — the same shape as the June
# fabrication. The `==>` line now prints the flags that were actually passed,
# so a CI log answers the question rather than implying it.
# `-o DIR` names the *parent*: cargo-mutants creates `DIR/mutants.out/` inside
# it. So a group's results are at `mutants.out/<group>/mutants.out/`, which is
# what `group_outcomes` returns and what the gate is pointed at.
group_outcomes() { echo "mutants.out/$1/mutants.out/outcomes.json"; }

# Exit status per group, so "no outcomes" can be told apart from "did not run".
declare -A GROUP_RC=()

run_group() {
    local name="$1" config="$2"
    shift 2
    local pkgs=()
    for c in "$@"; do pkgs+=(-p "$c"); done
    echo "==> mutants: $name (${#} crates, config $config, flags: ${FORWARDED[*]:-none})"
    local rc=0
    cargo mutants --config "$config" -o "mutants.out/$name" \
        "${pkgs[@]}" ${FORWARDED[@]+"${FORWARDED[@]}"} || rc=$?
    GROUP_RC["$name"]=$rc
}

# cargo-mutants creates its output directory but not the parent, so a fresh
# checkout fails all three groups with "create output parent directory ... No
# such file or directory" -- which `|| true` then swallows into a cheerful
# "Sweep complete". Only the mutation gate noticed, by finding no outcomes.
mkdir -p mutants.out

run_group lib      .cargo/mutants.toml          "${LIB_CRATES[@]}"
run_group bin      .cargo/mutants-bin.toml      "${BIN_CRATES[@]}"
run_group bin-fast .cargo/mutants-bin-fast.toml "${BIN_FAST_CRATES[@]}"

echo
# Say what is actually there. A group that failed to start leaves no
# outcomes.json, and claiming a complete sweep over it is how a fabricated
# result gets read as a real one.
#
# "No outcomes" is not by itself a failure: under `--in-diff` or `--shard` a
# group can legitimately have nothing to test, and it says so by exiting 0.
# What must never pass silently is a group that exited non-zero AND wrote
# nothing — that one did not run, and its crates are unmeasured.
produced=()
empty=()
failed=()
for g in lib bin bin-fast; do
    if [[ -f "$(group_outcomes "$g")" ]]; then
        produced+=("$g")
    elif [[ "${GROUP_RC[$g]}" -eq 0 ]]; then
        empty+=("$g")
    else
        failed+=("$g")
    fi
done

[[ ${#produced[@]} -gt 0 ]] && echo "Measured: ${produced[*]}."
[[ ${#empty[@]} -gt 0 ]] && echo "Nothing to test in: ${empty[*]} (scoped run)."
if [[ ${#failed[@]} -gt 0 ]]; then
    echo "Sweep INCOMPLETE: [${failed[*]}] exited non-zero and wrote no outcomes." >&2
    echo "Those groups did not run, so nothing can be concluded about their crates." >&2
    exit 1
fi
if [[ ${#produced[@]} -eq 0 ]]; then
    # Correct for a docs-only diff, and the shape a dropped scoping flag also
    # takes. Said plainly rather than failed on: the gate has nothing to judge
    # either way, and failing here would make a docs PR red.
    echo "No mutants were generated. Expected for a diff that touches no Rust;"
    echo "otherwise check that the scoping flags reached cargo-mutants (they are"
    echo "echoed on each ==> line above)."
    exit 0
fi
echo "Per-group results under mutants.out/{lib,bin,bin-fast}/mutants.out/."
