#!/bin/sh
# kmux — launch the native macOS SwiftUI GUI installed by `just install`.
#
# The macOS analog of the Linux `kmux` (GTK) binary: a `kmux` command on PATH
# that starts the GUI. It execs the app bundle's executable directly (rather
# than `open`ing the bundle) so it runs in the foreground attached to the
# terminal, forwarding args and stdio — matching how `kmux` behaves on Linux.
# Running the in-bundle Mach-O still yields the full bundled-app experience
# (Dock icon, app menu) because macOS finds Contents/Info.plist above it, and
# kmuxd sits beside it so find_server_binary() (which checks current_exe()'s
# own dir first) can auto-spawn the local daemon.
#
# Override the bundle location with KMUX_APP (defaults to ~/Applications/kmux.app).
app="${KMUX_APP:-$HOME/Applications/kmux.app}/Contents/MacOS/kmux-swift"
if [ ! -x "$app" ]; then
    echo "kmux: GUI not installed at $app — run 'just install' from the kmux repo" >&2
    exit 1
fi
exec "$app" "$@"
