#!/usr/bin/env bash
# The one dev entrypoint. Mirrors the installed `kmux` on PATH, but builds and
# runs the *debug* binaries from this checkout:
#
#   ./kmux                      # launch the GUI (Swift app on macOS, kmux-gtk on Linux)
#   ./kmux daemon status        # run a CLI subcommand (no GUI)
#   ./kmux diagnostic glyphs    # open a render-diagnostic session
#
# It just forwards to the `dev` mise task (which pins the debug daemon and routes
# CLI vs GUI per platform). Run it from anywhere — it cd's to its own directory.
set -euo pipefail
cd "$(dirname "$0")"
exec mise run dev -- "$@"
