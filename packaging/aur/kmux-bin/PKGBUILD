# Maintainer: Kono <opensource@getkono.com>
#
# Prebuilt-binary AUR package: installs the official GitHub Release tarball
# (verified by checksum) rather than building from source, the standard pattern
# for a `-bin` package. `pkgver` + `sha256sums_*` are bumped automatically by the
# kmux release workflow (.github/workflows/release.yml) and pushed to the AUR.
pkgname=kmux-bin
pkgver=0.2.0
pkgrel=1
pkgdesc="Terminal multiplexer and remote desktop with a native GUI (prebuilt)"
arch=('x86_64' 'aarch64')
url="https://github.com/getkono/kmux"
license=('AGPL-3.0-only' 'LicenseRef-Commercial')
depends=('gtk4' 'libadwaita')
makedepends=('patchelf')
provides=('kmux')
conflicts=('kmux')
# The release tarball ships already-stripped binaries; skipping the strip/debug
# steps avoids touching them (and a debug package with no symbols).
options=('!strip' '!debug')
source_x86_64=("kmux-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/kmux-$pkgver-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("kmux-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/kmux-$pkgver-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('bf37a7cd0442a45297d6007111849cedfd4463a295e2b9d2716c21f80be87107')
sha256sums_aarch64=('057c884bcb3198a7b33f9ef748f24aad7f97162bfe5c2efa48d8a3d56ac5473e')

package() {
    # The Linux target triple is just <arch>-unknown-linux-gnu, so $CARCH maps
    # directly (x86_64 / aarch64).
    local src="$srcdir/kmux-$pkgver-$CARCH-unknown-linux-gnu"

    install -Dm755 "$src/kmux"     "$pkgdir/usr/bin/kmux"
    install -Dm755 "$src/kmuxd"    "$pkgdir/usr/bin/kmuxd"
    install -Dm755 "$src/kmux-gtk" "$pkgdir/usr/bin/kmux-gtk"
    install -Dm755 "$src/libkmux_ghostty.so" "$pkgdir/usr/lib/kmux/libkmux_ghostty.so"

    # Process-isolation worker (issue #126); present in tarballs >= the release
    # that bundled it. Optional so this PKGBUILD also builds older releases.
    if [ -f "$src/kmux-vt-worker" ]; then
        install -Dm755 "$src/kmux-vt-worker" "$pkgdir/usr/bin/kmux-vt-worker"
    fi

    # Repoint the tarball's relocatable $ORIGIN runpath to the FHS libdir.
    patchelf --set-rpath /usr/lib/kmux "$pkgdir/usr/bin/kmuxd"
    if [ -f "$pkgdir/usr/bin/kmux-vt-worker" ]; then
        patchelf --set-rpath /usr/lib/kmux "$pkgdir/usr/bin/kmux-vt-worker"
    fi

    install -Dm644 "$src/share/applications/dev.getkono.kmux.desktop" \
        "$pkgdir/usr/share/applications/dev.getkono.kmux.desktop"
    install -Dm644 "$src/share/icons/hicolor/scalable/apps/dev.getkono.kmux.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.getkono.kmux.svg"
    install -Dm644 "$src/README.md" "$pkgdir/usr/share/doc/kmux/README.md"
    if [ -f "$src/LICENSE" ]; then
        install -Dm644 "$src/LICENSE" "$pkgdir/usr/share/licenses/kmux/LICENSE"
    fi
}
